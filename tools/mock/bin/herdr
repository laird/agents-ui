#!/usr/bin/env python3
"""herdr shim: `herdr agent list` from the swarm simulator, else the real herdr."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _shim import real  # noqa: E402

demo = os.environ.get("AGENTS_UI_DEMO_DIR")
if demo and sys.argv[1:3] == ["agent", "list"]:
    try:
        with open(os.path.join(demo, "state", "herdr.json")) as f:
            sys.stdout.write(f.read())
        sys.exit(0)
    except OSError:
        sys.exit(1)
path = real("herdr", os.path.dirname(os.path.abspath(__file__)))
if path:
    os.execv(path, [path] + sys.argv[1:])
sys.exit(1)
