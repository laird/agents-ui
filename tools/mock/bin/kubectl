#!/usr/bin/env python3
"""kubectl shim: `kubectl --context sim get ... -o json` from the cluster simulator, else the real kubectl."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _shim import real  # noqa: E402

demo, args = os.environ.get("AGENTS_UI_DEMO_DIR"), sys.argv[1:]
if demo and args[:2] == ["--context", "sim"] and "get" in args:
    name = "nodes.json" if "nodes" in args else "workloads.json"
    try:
        with open(os.path.join(demo, "state", "k8s", name)) as f:
            sys.stdout.write(f.read())
        sys.exit(0)
    except OSError:
        print("error: the simulated cluster is not running", file=sys.stderr)
        sys.exit(1)
path = real("kubectl", os.path.dirname(os.path.abspath(__file__)))
if path:
    os.execv(path, [path] + args)
print("kubectl: not installed", file=sys.stderr)
sys.exit(1)
