#!/usr/bin/env python3
"""gh shim: issues of the simulated repos from the swarm simulator; everything
else (and any other repo) goes to the real gh."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _shim import real  # noqa: E402

demo = os.environ.get("AGENTS_UI_DEMO_DIR")
args = sys.argv[1:]
cwd = os.getcwd()
if demo:
    src = os.path.realpath(os.path.join(demo, "src"))
    if args[:2] == ["auth", "status"]:
        print("Logged in to github.com (swarm simulator)")
        sys.exit(0)
    if args[:2] == ["issue", "list"] and os.path.realpath(cwd).startswith(src + os.sep):
        name = os.path.basename(os.path.realpath(cwd)).split("-wt-")[0]
        try:
            with open(os.path.join(demo, "state", "issues", name + ".json")) as f:
                sys.stdout.write(f.read())
        except OSError:
            sys.stdout.write("[]")
        sys.exit(0)
path = real("gh", os.path.dirname(os.path.abspath(__file__)))
if path:
    os.execv(path, [path] + args)
sys.stderr.write("gh: not installed\n")
sys.exit(1)
